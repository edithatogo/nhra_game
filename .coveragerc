[run]
branch = True
source = src, scripts
omit = 
    tests/*
    scripts/*
    .nox/*
    .gemini/*
    */__init__.py

[report]
show_missing = True
skip_covered = True
fail_under = 95
exclude_also =
    pragma: no cover
    if TYPE_CHECKING:
    if HAS_JAXTYPING:

exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
    if HAS_JAXTYPING:

[html]
directory = htmlcov
