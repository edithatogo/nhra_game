digraph MermaidConverted {
  rankdir=LR;
  graph [labelloc="t", label="Mermaid Chart - Create complex, visual diagrams with text.-2025-12-18-205805", fontsize=12];
  node [shape=box, style="rounded,filled", fillcolor="#F7F7F7", color="#555555", fontname="Inter", fontsize=11];
  edge [color="#444444", fontname="Inter", fontsize=10];
  ABF [label="fa:fa-database Provider ABF/coding\nClassification, coding accuracy, gaming risk"];
  BARG [label="fa:fa-handshake Intergovernmental bargaining (repeated)\nCommonwealth ↔ States\n% share, caps, indexation"];
  COMP [label="fa:fa-shield-alt Compliance &amp; integrity\nMaintenance-of-effort; audits; allocation"];
  DEF [label="fa:fa-balance-scale Definition &amp; measurement\nNEP vs actual costs; baselines; indexation"];
  DISC [label="fa:fa-procedures Discharge/placement\nAged Care &amp; NDIS constraints → delayed discharge"];
  GOV [label="fa:fa-project-diagram Governance integration\nParallel models (e.g., UCCs) vs LHN governance"];
  OUT [label="fa:fa-hospital-user Operational pressure &amp; visible failure\nExit block → ED overcrowding → ramping\nClinical risk &amp; staff harm"];
  POL [label="fa:fa-bullhorn Political blame/credit signalling\nVoters, media, central agencies"];
  SOFT [label="fa:fa-life-ring Soft budget constraint\nInterim top-ups / bailout expectations"];
  VFI [label="fa:fa-exchange-alt VFI externality / cost-shifting\nUpstream levers vs downstream hospital risk"];
  DEF -> BARG;
  SOFT -> BARG;
  POL -> BARG;
  VFI -> OUT;
  DISC -> OUT;
  ABF -> DEF;
  COMP -> DEF;
  GOV -> VFI;
}