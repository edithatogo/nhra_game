  COMP [label="fa:fa-shield-alt Compliance &amp; integrity<br>Maintenance-of-effort; audits; allocation"];
  DEF [label="fa:fa-balance-scale Definition &amp; measurement<br>NEP vs actual costs; baselines; indexation"];
  DISC [label="fa:fa-procedures Discharge/placement<br>Aged Care &amp; NDIS constraints → delayed discharge"];
