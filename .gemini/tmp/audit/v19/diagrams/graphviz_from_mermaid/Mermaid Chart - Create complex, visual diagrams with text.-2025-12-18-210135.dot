  DISCHARGE [label="Placement game\nAged Care/NDIS delays"];
  EXTERNAL [label="Externality game\ncost shifting (VFI)"];
  GOVINT [label="Governance game\nintegration vs parallelism"];
  LEVER1 [label="Pooled funding / shared KPIs\nshared accountability"];
  LEVER2 [label="Mandated integration\n(UCCs + digital handover)"];
  LEVER3 [label="Indexation realism\n(workforce cost growth)"];
  METRICS [label="Definition game\nNEP vs real cost"];
  PRESS [label="Visible system pressure\nexit block → ED crowding → ramping"];
  RISK [label="Clinical risk\nharm + staff burnout"];
  SIGNAL [label="Blame/credit game\npublic signalling"];
  EXTERNAL -> DISCHARGE [label="spillovers"];
  DISCHARGE -> PRESS [label="delayed discharge"];
  EXTERNAL -> PRESS [label="downstream load"];
  PRESS -> RISK [label="overcrowding + holds"];
  PRESS -> SIGNAL [label="media salience"];
  RISK -> SIGNAL [label="safety narrative"];
  SIGNAL -> BARG [label="hardens/softens stance"];
  METRICS -> BARG [label="defines “45%”"];
  CODING -> METRICS [label="data quality affects"];
  COMPLY -> METRICS [label="audit rules affect"];
  BARG -> METRICS [label="sets rules for"];
  BAILOUT -> BARG [label="bailout expectations"];
  BARG -> BAILOUT [label="interim extensions"];
  GOVINT -> EXTERNAL [label="fragmentation ↑"];
  GOVINT -> RISK [label="handover continuity"];
  PRESS -> COMPLY [label="scrutiny ↑", style="dashed"];
  COMPLY -> PRESS [label="admin burden ↑", style="dashed"];
  LEVER1 -> EXTERNAL [label="internalise externalities", style="dashed"];
  LEVER1 -> BARG [label="reduce cost-shift payoff", style="dashed"];
  LEVER2 -> GOVINT [label="reduces parallelism", style="dashed"];
  LEVER2 -> RISK [label="improves continuity", style="dashed"];
  LEVER3 -> METRICS [label="narrows gap", style="dashed"];
